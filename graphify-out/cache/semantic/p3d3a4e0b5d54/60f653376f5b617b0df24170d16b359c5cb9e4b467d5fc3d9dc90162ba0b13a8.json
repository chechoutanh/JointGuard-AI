{"nodes": [{"id": "reports_latex_jointguard_report", "label": "JointGuard AI technical report (PDF)", "file_type": "paper", "source_file": "reports/latex/jointguard_report.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null}, {"id": "reports_latex_jointguard_report_research_question", "label": "Research question: detect friction without load/speed false alarms", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 1", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "Torque and tracking error also rise for heavier loads and faster motion, so a naive detector would false-alarm; problem split into detect, diagnose, estimate wear (wear needs run-to-failure data, out of scope)."}, {"id": "reports_latex_jointguard_report_two_joint_arm_dynamics", "label": "2-DOF arm dynamics M(q)q'' + C q' + G + tau_f = tau (RK4, 1 ms)", "file_type": "rationale", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 2.1", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "Motion comes only from integrating the equations, never from the target path; payload merged into link 2 to change M and G consistently."}, {"id": "reports_latex_jointguard_report_pd_controller", "label": "PD controller with gravity compensation (friction-blind, 100 Hz)", "file_type": "rationale", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 2.2", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "Controller does not compensate friction, so rising friction surfaces as larger tracking error and PD torque."}, {"id": "reports_latex_jointguard_report_friction_fault_model", "label": "Friction fault model: multiplier m on viscous + tanh Coulomb friction", "file_type": "rationale", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 2.3", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "Anomaly label m >= 1.5 fixed before data generation and independent of tracking error; mild, severe and gradual fault shapes; one faulty joint at a time."}, {"id": "reports_latex_jointguard_report_group_split_protocol", "label": "Group-wise 60/20/20 split and held-out stress set", "file_type": "rationale", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 3", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "Splitting by group prevents near-duplicate leakage; all tuning on train/val only; test and stress reported separately to avoid optimistic bias."}, {"id": "reports_latex_jointguard_report_stress_test", "label": "Stress test (2-3 kg payload, fast motion, point-to-point trajectory)", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 3, 4.3", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null}, {"id": "reports_latex_jointguard_report_causal_window_features", "label": "24 causal window features (12 per joint, 1.0 s window every 0.1 s)", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 4.1", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null}, {"id": "reports_latex_jointguard_report_direction_weighted_error", "label": "Direction-weighted tracking error e_dir", "file_type": "rationale", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 4.1 Eq 4", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "Friction always opposes motion so the arm lags in the direction of motion, whereas payload adds a gravity load the controller already compensates; most important feature (joint 1, 13.8%)."}, {"id": "reports_latex_jointguard_report_random_forest_detector", "label": "Random Forest detector (200 trees, val AP 0.927)", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 4.2", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null}, {"id": "reports_latex_jointguard_report_alarm_rule", "label": "Alarm rule: 8 consecutive windows >= 0.40 on, 5 below off", "file_type": "rationale", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 4.2", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "Chosen on validation to maximise F1 subject to <= 0.5 false alarms/min; value 8 at grid edge reported rather than adjusted after test."}, {"id": "reports_latex_jointguard_report_error_threshold_baseline", "label": "Error-threshold baseline (max_j RMS(e_j)/r_j)", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 4.2", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null}, {"id": "reports_latex_jointguard_report_detection_results", "label": "Detection results: 32/32 test, 3.88 FA/min on stress", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 4.3 Table 3", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null}, {"id": "reports_latex_jointguard_report_diagnosis_stage", "label": "Diagnosis stage: joint classifier + friction-multiplier regressor", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 5", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "An alarm alone does not tell a technician much; runs only while alarm is on, averaged over last 20 above-threshold windows; estimates regress toward the middle of the training range."}, {"id": "reports_latex_jointguard_report_limitations", "label": "Limitations (simulation only, no generalisation, no RUL)", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 6", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null}, {"id": "reports_latex_jointguard_report_physics_residual_next_step", "label": "Next step: physics-residual features (measured vs nominal-model torque)", "file_type": "concept", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 7", "source_url": null, "captured_at": null, "author": "Tuan Anh Nguyen", "contributor": null, "rationale": "So load and friction separate by construction; re-test on a fresh stress set since the current one has been examined."}, {"id": "reports_latex_jointguard_report_scripts_run_pipeline", "label": "scripts.run_pipeline (referenced)", "file_type": "code", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_standard_report_en", "label": "reports/standard/report_en.md detailed results report", "file_type": "document", "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 8", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "reports_latex_jointguard_report", "target": "reports_latex_jointguard_report_research_question", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec 1", "weight": 1.0}, {"source": "reports_latex_jointguard_report_pd_controller", "target": "reports_latex_jointguard_report_two_joint_arm_dynamics", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "reports/latex/jointguard_report.pdf", "source_location": "Sec