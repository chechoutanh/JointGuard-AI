{"nodes": [{"id": "results_standard_figures_signature_load_vs_friction_figure", "label": "Signature Plot: Load vs Friction (torque RMS vs tracking error)", "file_type": "image", "source_file": "results/standard/figures/signature_load_vs_friction.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "results_standard_figures_signature_load_vs_friction_load_friction_separability", "label": "Payload vs friction fault separability", "file_type": "concept", "source_file": "results/standard/figures/signature_load_vs_friction.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heavier payload (2.0 kg vs 0.5 kg) mainly shifts joint torque RMS higher (J1 ~30-60 to ~40-83 N m) while tracking error stays similar (J1 ~0-6 mrad, J2 ~2-19 mrad). Friction x3 raises tracking error along motion (J1 ~5-11 mrad, J2 ~20-34 mrad) across the whole torque range. Torque alone cannot separate load from friction; tracking error separates them, most cleanly on joint 2 where clusters do not overlap."}, {"id": "results_standard_figures_signature_load_vs_friction_torque_rms", "label": "Joint torque RMS feature", "file_type": "concept", "source_file": "results/standard/figures/signature_load_vs_friction.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "results_standard_figures_signature_load_vs_friction_tracking_error_along_motion", "label": "Tracking error along motion feature", "file_type": "concept", "source_file": "results/standard/figures/signature_load_vs_friction.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "results_standard_figures_signature_load_vs_friction_friction_x3_fault", "label": "Friction x3 fault (per joint)", "file_type": "concept", "source_file": "results/standard/figures/signature_load_vs_friction.png", "sou