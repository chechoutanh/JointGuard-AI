{"nodes": [{"id": "reports_standard_report_en", "label": "JointGuard AI standard report (EN)", "file_type": "document", "source_file": "reports/standard/report_en.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_standard_report_en_jointguard_ai", "label": "JointGuard AI", "file_type": "concept", "source_file": "reports/standard/report_en.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_standard_report_en_research_question", "label": "Research question: detect friction rise without false alarms on speed/load", "file_type": "concept", "source_file": "reports/standard/report_en.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reports_standard_report_en_anomaly_definition", "label": "Anomaly definition: joint friction >= 1.5x healthy", "file_type": "rationale", "source_file": "reports/standard/report_en.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed before data generation; label never uses tracking error."}, {"id": "reports_standard_report_en_two_link_arm_dynamics", "label": "2-DOF planar arm dynamics M(q)q'' + C q' + G + tau_f = tau", "file_type": "concept", "source_file": "reports/standard/report_en.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accelerations by Gaussian elimination, not matrix inversion; payload merged into link 2 so it affects both M and G."}, {"id": "reports_standard_report_en_smoothed_coulomb_friction", "label": "Friction model b*q' + tau_c*tanh(q'/eps)", "file_type": "concept", "source_file": "reports/standard/report_en.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tanh smooths Coulomb discontinuity;