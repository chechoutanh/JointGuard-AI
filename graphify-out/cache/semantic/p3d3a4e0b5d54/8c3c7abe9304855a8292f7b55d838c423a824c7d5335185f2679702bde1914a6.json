{"nodes": [{"id": "readme_jointguard_ai", "label": "JointGuard AI", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_research_question", "label": "Research Question: detect friction without false alarms on load/speed", "file_type": "concept", "source_file": "README.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Healthy arms carrying more load or moving faster also need more torque and lag more, so a naive detector would false-alarm in normal operation."}, {"id": "readme_detect_diagnose_estimate", "label": "Detect / Diagnose / Estimate Wear problem split", "file_type": "concept", "source_file": "README.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wear estimation (RUL) not addressed because it needs run-to-failure data that injected faults cannot provide."}, {"id": "readme_two_joint_arm_simulator", "label": "2-joint arm physics simulator (RK4 @ 1 kHz)", "file_type": "concept", "source_file": "README.md", "source_location": "L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arm motion comes only from the equation of motion, never copied from the target path; payload merged into link 2 to affect inertia and gravity."}, {"id": "readme_equation_of_motion", "label": "Equation of motion M(q)q'' + C q' + G(q) + tau_f = tau", "file_type": "concept", "source_file": "README.md", "source_location": "L112", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_pd_gravity_controller", "label": "PD + gravity compensation controller (100 Hz)", "file_type": "concept", "source_file": "README.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controller deliberately does not compensate friction, so rising friction shows up as larger tracking error and torque, the signal models learn from."}, {"id": "readme_friction_fault_model", "label": "Friction fault model (multiplier m, label m >= 1.5)", "file_type": "concept", "source_file": "README.md", "source_location": "L130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Labelling rule fixed before any data was generated and never uses tracking error, to avoid circular labels."}, {"id": "readme_fault_types", "label": "Fault types: mild jump, severe jump, gradual ramp", "file_type": "concept", "source_file": "README.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_window_features", "label": "Window features (1.0 s window, every 0.1 s, 24 numbers)", "file_type": "concept", "source_file": "README.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strictly causal; time, run IDs, true payload, friction values and labels never used as inputs (enforced by tests)."}, {"id": "readme_directional_tracking_error", "label": "Tracking error along direction of motion (e_dir)", "file_type": "concept", "source_file": "README.md", "source_location": "L140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Friction always opposes motion so the arm lags in its direction of motion, whereas payload mostly adds gravity load the controller already compensates."}, {"id": "readme_random_forest_detector", "label": "Random Forest detector (200 trees, val AP 0.927)", "file_type": "concept", "source_file": "README.md", "source_location": "L148", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected from 32 configurations by validation average precision."}, {"id": "readme_alarm_rule", "label": "Alarm persistence rule (8 windows >= 0.40 on, 5 off)", "file_type": "concept", "source_file": "README.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen on validation to maximise F1 with at most 0.5 false alarms per minute."}, {"id": "readme_error_threshold_baseline", "label": "Error-threshold baseline detector", "file_type": "concept", "source_file": "README.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_diagnosis_stage", "label": "Diagnosis stage (joint classifier + friction multiplier regressor)", "file_type": "concept", "source_file": "README.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained only on training fault windows, reusing detector settings with no extra tuning; output averaged over last 20 above-threshold windows, shown only while alarm is on."}, {"id": "readme_group_based_splits", "label": "Group-based train/val/test splits (60/20/20)", "file_type": "concept", "source_file": "README.md", "source_location": "L165", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs sharing trajectory, payload and healthy friction are kept together so near-duplicates never leak across splits."}, {"id": "readme_stress_test_set", "label": "Out-of-distribution stress test set", "file_type": "concept", "source_file": "README.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heavier payloads (2-3 kg), faster motion and unseen trajectory type; reported separately and never averaged with test."}, {"id": "readme_event_level_metrics", "label": "Event-level metrics (false alarms, delay, detections)", "file_type": "concept", "source_file": "README.md", "source_location": "L168", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ood_generalisation_failure", "label": "Negative result: fails outside training range", "file_type": "concept", "source_file": "README.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reported rather than tuned away; model mistakes heavier loads and faster motion for friction."}, {"id": "readme_desktop_demo", "label": "Pygame desktop demo", "file_type": "concept", "source_file": "README.md", "source_location": "L293", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI PREDICTION panel separated from SIMULATOR GROUND TRUTH panel; fault keys only change physics friction parameters so alarms come only from the model."}, {"id": "readme_web_demo_page", "label": "Project web page (jointguardaii.vercel.app)", "file_type": "concept", "source_file": "README.md", "source_location": "L317", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_no_silent_overwrite", "label": "No silent overwrite convention", "file_type": "rationale", "source_file": "README.md", "source_location": "L281", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scripts stop if output exists; require new --name/--tag or explicit --overwrite to protect earlier results."}, {"id": "readme_reproducibility", "label": "Data availability and reproducibility (seed 20261024)", "file_type": "concept", "source_file": "README.md", "source_location": "L324", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw signals excluded to keep repo small; regeneration from manifest seeds gives identical signals."}, {"id": "readme_coordinate_conventions", "label": "Coordinate and sign conventions", "file_type": "concept", "source_file": "README.md", "source_location": "L342", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_limi